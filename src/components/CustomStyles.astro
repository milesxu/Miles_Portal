---
// Shared visual tokens for the Miles sites. Keep Portal and Blog aligned here.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(56 189 248);
    --aw-color-secondary: rgb(14 165 233);
    --aw-color-accent: rgb(129 140 248);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(30 41 59);
    --aw-color-text-muted: rgb(51 65 85 / 70%);
    --aw-color-bg-page: rgb(248 250 252);

    --aw-color-bg-page-dark: rgb(7 12 24);

    ::selection {
      background-color: rgb(125 211 252 / 45%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(56 189 248);
    --aw-color-secondary: rgb(125 211 252);
    --aw-color-accent: rgb(129 140 248);

    --aw-color-text-heading: rgb(241 245 249);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(203 213 225 / 72%);
    --aw-color-bg-page: rgb(7 12 24);

    ::selection {
      background-color: rgb(56 189 248 / 35%);
      color: white;
    }
  }
</style>
